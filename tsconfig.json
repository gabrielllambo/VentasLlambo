/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "compileOnSave": false,
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "baseUrl": "./src",
        "rootDir": "./src",
        "outDir": "./dist/out-tsc",
        "sourceMap": true,
        "declaration": false,
        "downlevelIteration": true,
        "experimentalDecorators": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "target": "ES2022",
        "module": "ES2022",
        "useDefineForClassFields": false,
        "paths": {
            "@core/*": [
                "src/app/core/*"
            ],
            "@modules/*": [
                "src/app/"
            ],
            "@shared/*": [
                "src/app/shared/*"
            ],
        },
        "lib": [
            "ES2022",
            "dom"
        ]
    },
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false
    },
    "exclude": [
        "server.ts",
        "src/main.server.ts"
    ]
}